# SecureMeet AI - Environment Configuration Example
# Copy this file to .env and replace with appropriate values

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------
ENVIRONMENT=development
APP_NAME="SecureMeet AI"
APP_VERSION=0.1.0
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=generate_a_secure_random_64_char_key_here
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=securemeet_admin
POSTGRES_PASSWORD=change_this_insecure_password
POSTGRES_DB=securemeet_db
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# -----------------------------------------------------------------------------
# CACHE & BROKER (Redis)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# -----------------------------------------------------------------------------
# CELERY TASK QUEUE
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/2

# -----------------------------------------------------------------------------
# SECURITY & AUTHENTICATION (JWT & OAuth2)
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=generate_a_secure_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth2 Provider Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_TENANT_ID=

# -----------------------------------------------------------------------------
# AI ENGINE SETTINGS
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL_NAME=gpt-4o
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.2

# -----------------------------------------------------------------------------
# NOTIFICATIONS (SMTP / Slack / Webhook)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=no-reply@securemeet.ai
EMAILS_FROM_NAME="SecureMeet AI Security"

# -----------------------------------------------------------------------------
# AUDIT & COMPLIANCE
# -----------------------------------------------------------------------------
AUDIT_LOG_RETENTION_DAYS=365
ENABLE_STRICT_PII_MASKING=True
